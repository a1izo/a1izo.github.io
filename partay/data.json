 "stories": [
  {
   "id": "US1",
   "text": "As a Party Host, I want to create a party by logging in with Spotify, so that Partay creates a party playlist on my account.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F1",
   "position": 1
  },
  {
   "id": "US2",
   "text": "As a Party Guest, I want to join a party by scanning a QR code and picking a nickname, so that I join in under a minute without an account.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F2",
   "position": 2
  },
  {
   "id": "US3",
   "text": "As a Party Guest, I want to search Spotify and add a song to the queue, so that my song gets played without asking the host.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F3",
   "position": 3
  },
  {
   "id": "US4",
   "text": "As a Party Guest, I want to vote on songs in the queue and take my vote back, so that the group decides what plays next.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F4",
   "position": 4
  },
  {
   "id": "US5",
   "text": "As a Party Guest, I want to see the queue, the votes and the song that plays now, so that I know what comes next.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F5, F6",
   "position": 5
  },
  {
   "id": "US6",
   "text": "As a Party Host, I want to have the party playlist stay in vote order, so that the top song plays next without me touching it.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F7",
   "position": 6
  },
  {
   "id": "US7",
   "text": "As a Party Host, I want to remove songs from the queue, so that I keep control of the mood.",
   "priority": "Core",
   "sprint": "Sprint 1",
   "status": "To do",
   "points": null,
   "feature": "F8",
   "position": 7
  },
  {
   "id": "US8",
   "text": "As a Party Host, I want to limit each guest to 3 songs in the queue, so that one guest does not fill the queue.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F9",
   "position": 8
  },
  {
   "id": "US9",
   "text": "As a Party Guest, I want to choose whether my name shows on the songs I add, so that I add songs without being judged.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F10",
   "position": 9
  },
  {
   "id": "US10",
   "text": "As a Party Host, I want to lock the queue, so that no new songs come in when the queue is long enough.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F11",
   "position": 10
  },
  {
   "id": "US11",
   "text": "As a Party Host, I want to block a guest, so that the guest and their songs leave the party and the guest cannot rejoin.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F12",
   "position": 11
  },
  {
   "id": "US12",
   "text": "As a Party Host, I want to keep or remove the party playlist when the party ends, so that we keep the music of the night if we want to.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F13",
   "position": 12
  },
  {
   "id": "US13",
   "text": "As a Party Host, I want to set a party theme, so that guests pick songs that fit the party.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F14",
   "position": 13
  },
  {
   "id": "US14",
   "text": "As a Party Host, I want to filter out explicit songs, so that the music fits my guests.",
   "priority": "Additional",
   "sprint": "Sprint 2",
   "status": "To do",
   "points": null,
   "feature": "F15",
   "position": 14
  },
